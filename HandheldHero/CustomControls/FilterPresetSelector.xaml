<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Top tabs (quick filter presets). Playnite creates one CheckBoxEx per preset; LB / RB cycle through them.
        Every tab keeps the same weight so labels never shift. The selected tab is brighter and gets an accent
        underline the width of its label. Switching hands the line over: the old one shrinks away quickly and
        the new one grows in just after it. (Each tab only knows its own state, so a sliding line is not possible.)
        Underline opacity, pill fill and inactive colour come from Constants.xaml so Theme Options presets can
        switch to the soft-pill or text-only styles.
    -->
    <Style x:Key="ItemFilterQuickPreset" TargetType="CheckBoxEx">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TabInactiveBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBoxEx">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="LineIn">
                            <DoubleAnimation Storyboard.TargetName="LineScale" Storyboard.TargetProperty="ScaleX"
                                             To="1" BeginTime="0:0:0.1" Duration="0:0:0.28">
                                <DoubleAnimation.EasingFunction>
                                    <ExponentialEase EasingMode="EaseOut" Exponent="6" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                        <Storyboard x:Key="LineOut">
                            <DoubleAnimation Storyboard.TargetName="LineScale" Storyboard.TargetProperty="ScaleX"
                                             To="0" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <QuadraticEase EasingMode="EaseIn" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Border x:Name="TabBorder" Margin="2,0" Padding="22,10,22,14" CornerRadius="999"
                            Background="Transparent">
                        <Grid>
                            <TextBlock x:Name="TextContent"
                                       Text="{Binding Name}"
                                       FontFamily="{DynamicResource FontUI}" FontWeight="SemiBold"
                                       FontSize="27"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- underline: label width, 4 px, just below the text -->
                            <Border x:Name="Line" Height="4" CornerRadius="2" VerticalAlignment="Bottom" Margin="0,0,0,-12"
                                    Background="{DynamicResource AccentBrush}" Opacity="{DynamicResource TabUnderlineOpacity}"
                                    RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="LineScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TextContent" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabPillBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="LineInAnim" Storyboard="{StaticResource LineIn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="LineInAnim" />
                                <BeginStoryboard Storyboard="{StaticResource LineOut}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TextContent" Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type FilterPresetSelector}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterPresetSelector}">
                    <ItemsControlEx x:Name="PART_ItemsFilterPresets" Focusable="False"
                                    KeyboardNavigation.DirectionalNavigation="Once"
                                    HorizontalLayout="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControlEx>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
