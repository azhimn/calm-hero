<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!--
        Item container for the stock game grid (ALL GAMES).
        Selection = "Lift" by default: the selected cover grows to 1.06x and every other cover is dimmed by a
        plain black layer. The ring is drawn only when a Theme Options preset gives SelectionRingThickness a
        value. No shader effects, so it stays cheap on handheld iGPUs.
        Durations are literal: Playnite parses each theme file on its own, and storyboards in templates can't
        take resource values.
    -->
    <Style x:Key="ListGameItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="SelectedOn">
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX"
                                             To="1.06" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY"
                                             To="1.06" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="DimHost" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.18" />
                        </Storyboard>
                        <Storyboard x:Key="SelectedOff">
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="DimHost" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.18" />
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid Margin="{Settings FullscreenItemSpacingMargin}"
                          RenderTransformOrigin="0.5,0.5"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <ContentPresenter />

                        <!-- dim layer for unselected covers (strength from Constants: UnselectedDimOpacity) -->
                        <Grid x:Name="DimHost" IsHitTestVisible="False">
                            <Border CornerRadius="10" Background="Black" Opacity="{DynamicResource UnselectedDimOpacity}" />
                        </Grid>

                        <!-- optional ring (Ring / Thin accent presets) -->
                        <Border x:Name="Ring" Margin="-7" CornerRadius="16" IsHitTestVisible="False" Visibility="Hidden"
                                BorderThickness="{DynamicResource SelectionRingThickness}"
                                BorderBrush="{DynamicResource SelectionRingBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SelectedAnimation" Storyboard="{StaticResource SelectedOn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SelectedAnimation" />
                                <BeginStoryboard Storyboard="{StaticResource SelectedOff}" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
