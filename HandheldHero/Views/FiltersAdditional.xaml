<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type FiltersAdditional}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FiltersAdditional}">
                    <Border Background="{DynamicResource OverlayMenuBackgroundBrush}" BorderBrush="{DynamicResource SurfaceLineBrush}"
                            BorderThickness="1" CornerRadius="22" Margin="20,0,0,20" Padding="10,18,10,18">
                    <DockPanel Width="{DynamicResource FilterPanelWidth}"
                                x:Name="PART_MenuHost">
                        <ButtonEx DockPanel.Dock="Top"
                                  Margin="8,2,8,10"
                                  x:Name="PART_ButtonBack">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76B;" FontFamily="{DynamicResource FontIcons}"
                                            FontSize="20" VerticalAlignment="Center"
                                            Margin="0,0,10,0" />
                                    <TextBlock Text="{DynamicResource LOCFilters}"
                                            VerticalAlignment="Center"
                                            Style="{DynamicResource TextBlockBaseStyle}"/>
                                </StackPanel>
                            </Button.Content>
                        </ButtonEx>
                        <ItemsControlEx x:Name="PART_ItemsHost"
                                        DockPanel.Dock="Top" Focusable="False"
                                        KeyboardNavigation.DirectionalNavigation="Once" />
                    </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>