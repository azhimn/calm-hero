                                                                            <DataTrigger Binding="{Binding SelectedGame.IsInstalled}" Value="True">
                                                                                <Setter Property="Text" Value="&#xE73E;" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                                                        <Setter Property="Text" Value="Not installed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SelectedGame.IsInstalled}" Value="True">
                                                                                <Setter Property="Text" Value="Installed" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource HeroPill}">
                                                        <Border.Visibility>
                                                            <Binding Path="SelectedGame.Favorite" Converter="{StaticResource BooleanToVisibilityConverter}" />
                                                        </Border.Visibility>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE735;" Style="{StaticResource HeroPillIcon}" Foreground="#FFFFD65A" />
                                                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       Foreground="#FFFFD65A" Text="Favorite" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- carousel mode: display-only list, scaled to fit, selection always centred -->
                                        <Viewbox x:Name="CarouselHost" Stretch="Uniform" StretchDirection="DownOnly"
                                                 VerticalAlignment="Bottom" Margin="0,0,0,0">
                                            <Viewbox.Style>
                                                <Style TargetType="Viewbox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Carousel">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Viewbox.Style>
                                            <Grid Width="1920" Height="500">
                                                <!-- zero-size Canvas: the driver's Width changes never propagate layout to the row -->
                                                <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                                    <Border x:Name="CarouselShiftDriver" Width="0" Height="0" Visibility="Hidden" />
                                                </Canvas>
                                                <!-- Virtualized: Playnite's FullscreenTilePanel only creates about 10 slots around its scroll
                                                     position (one before it, Columns + 1 after), so memory and per-move work stay flat for any
                                                     library size. (A plain StackPanel built every game: about 0.3 MB each, and an out-of-memory
                                                     crash near 10,000 games.)
                                                     Geometry: 310 px slots, panel 8.5 slots wide (Columns 8 + Playnite's half-slot margin), each
                                                     item drawn a quarter slot in. CarouselShiftDriver.Width = SelectedIndex x 310 (S). The panel
                                                     scrolls to S - 930 (3 slots before the selection, so the slots to its left exist too), clamped
                                                     to its range [0, N x 310 - 2635]; the list's TranslateTransform adds back whatever the clamp
                                                     removed at either end. Net effect: slot i sits at 805 + i x 310 - S, so the selection is centred. -->
                                                <ListBox x:Name="CarouselList" Width="1920" Height="500" AlternationCount="100000"
                                                         Background="Transparent" BorderThickness="0"
                                                         Focusable="False" IsTabStop="False"
                                                         ItemsSource="{Binding GamesView.CollectionView}"
                                                         SelectedItem="{Binding SelectedGame, Mode=OneWay}"
                                                         IsSynchronizedWithCurrentItem="False"
                                                         ItemContainerStyle="{StaticResource CarouselItemStyle}">
                                                    <!-- Tag = the selected slot's AlternationIndex, written by CarouselItemStyle; until then SelectedIndex. -->
                                                    <ListBox.Tag>
                                                        <Binding Path="SelectedIndex" RelativeSource="{RelativeSource Self}" />
                                                    </ListBox.Tag>
                                                    <ListBox.RenderTransform>
                                                        <TranslateTransform>
                                                            <TranslateTransform.X>
                                                                <MultiBinding Converter="{StaticResource MathConverter}"
                                                                              ConverterParameter="Min(Max([0] - 930, 0), Max(0, [1] * 310 - 2635)) - [0] + 930">
                                                                    <Binding Path="Width" ElementName="CarouselShiftDriver" />
                                                                    <Binding Path="Items.Count" ElementName="CarouselList" />
                                                                </MultiBinding>
                                                            </TranslateTransform.X>
                                                        </TranslateTransform>
                                                    </ListBox.RenderTransform>
                                                    <!-- The strip slides to the new game instead of jumping. ChangePropertyAction can only
                                                         animate properties of elements in the visual tree, so it animates the Width of the
                                                         invisible CarouselShiftDriver (310 px per item); the scroll offset and shift follow it. -->
                                                    <i:Interaction.Triggers>
                                                        <ic:PropertyChangedTrigger Binding="{Binding SelectedIndex, ElementName=CarouselList}">
                                                            <ic:ChangePropertyAction TargetObject="{Binding ElementName=CarouselShiftDriver}" PropertyName="Width"
                                                                                     Duration="{DynamicResource CarouselSlideDuration}"
                                                                                     Value="{Binding SelectedIndex, ElementName=CarouselList, Converter={StaticResource MathConverter}, ConverterParameter='x &lt; 0 ? 0 : x * 310'}" />
                                                        </ic:PropertyChangedTrigger>
                                                    </i:Interaction.Triggers>
                                                    <ListBox.Template>
                                                        <ControlTemplate TargetType="ListBox">
                                                            <!-- A Canvas so the strip is not clipped; the explicit size is the panel's viewport. -->
                                                            <Canvas Width="1920" Height="500">
                                                                <ItemsPresenter Canvas.Left="-202.5" Canvas.Top="0" Width="2635" Height="500" />
                                                            </Canvas>
                                                        </ControlTemplate>
                                                    </ListBox.Template>
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <FullscreenTilePanel UseHorizontalLayout="True" Columns="8" ItemAspectRatio="310:500">
                                                                <FullscreenTilePanel.HorizontalOffset>
                                                                    <MultiBinding Converter="{StaticResource MathConverter}"
                                                                                  ConverterParameter="Min(Max([0] - 930, 0), Max(0, [1] * 310 - 2635))">
                                                                        <Binding Path="Width" ElementName="CarouselShiftDriver" />
                                                                        <Binding Path="Items.Count" ElementName="CarouselList" />
                                                                    </MultiBinding>
                                                                </FullscreenTilePanel.HorizontalOffset>
                                                            </FullscreenTilePanel>
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <GameListItem Style="{DynamicResource ListGameItemTemplate}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <!-- touch: tap left / right of the centred cover to step through the row -->
                                                <Button HorizontalAlignment="Left" Width="790" Focusable="False" IsTabStop="False"
                                                        Style="{StaticResource CarouselTapZone}"
                                                        Command="{Binding SelectPrevGameCommand}" />
                                                <Button HorizontalAlignment="Right" Width="790" Focusable="False" IsTabStop="False"
                                                        Style="{StaticResource CarouselTapZone}"
                                                        Command="{Binding SelectNextGameCommand}" />
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </Grid>
                            </DockPanel>

                            <TextBlock Grid.Row="1" FontSize="40"
                                       Text="{DynamicResource LOCNoGamesFound}"
                                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- ============ BOTTOM HINT BAR ============ -->
                            <Grid Grid.Row="2" Background="{DynamicResource BottomBarBackgroundBrush}"
                                  Height="84">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!--Install-->
                                    <ButtonEx x:Name="PART_ButtonInstall"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCInstallGame}" />
                                    <!--Play-->
                                    <ButtonEx x:Name="PART_ButtonPlay"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCPlayGame}" />
                                    <!--Details-->
                                    <ButtonEx x:Name="PART_ButtonDetails"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCGameDetails}" />
                                    <!--Options-->
                                    <ButtonEx x:Name="PART_ButtonGameOptions"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCGameOptions}" />
                                    <!--Search-->
                                    <ButtonEx x:Name="PART_ButtonSearch"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCSearchLabel}" />
                                    <!--Filter-->
                                    <ButtonEx x:Name="PART_ButtonFilter"
                                              Style="{DynamicResource ButtonBottomMenu}"
                                              Content="{DynamicResource LOCFilter}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" x:Name="PART_ElemSearchActive"
                                            VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                            Margin="0,15,0,0">
                                    <TextBlock  FontSize="18"
                                                TextAlignment="Center"
                                                Style="{DynamicResource TextBlockBaseStyle}"
                                                Text="{DynamicResource LOCGameListSearchResults}"/>
                                    <TextBlock  Foreground="White"
                                                TextAlignment="Center"
                                                Style="{DynamicResource TextBlockBaseStyle}"
                                                Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" x:Name="PART_ElemExtraFilterActive"
                                           FontSize="20"
                                           VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                           TextAlignment="Center"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           Text="{DynamicResource LOCGameListExtraFiltered}"/>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel x:Name="PART_ElemProgressIndicator" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock x:Name="PART_TextProgressTooltip"
                                                   Margin="0,0,15,0" FontSize="20" VerticalAlignment="Center"
                                                   Style="{DynamicResource TextBlockBaseStyle}"/>
                                        <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False"
                                                        Height="38" Width="38" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- LB / RB switch the tabs -->
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptLB}" Height="34"
                                                    Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" />
                                    <Border Width="8" />
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptRB}" Height="34"
                                                    Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" />
                                    <TextBlock Text="Tabs" Style="{DynamicResource TextBlockBaseStyle}"
                                               FontFamily="{DynamicResource FontUI}" FontWeight="SemiBold" FontSize="23"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <!-- Start tab (see StartTabPicker above). Playnite restores the last used tab shortly after the view
                                 loads, so the first tab is applied on Loaded and then re-applied by a timer for the first few
                                 seconds; after 5 s the picker disarms and tab switching is left alone.
                                 (Not a PropertyChanged trigger on ActiveFilterPreset: setting the tab from inside its own change
                                 notification fights the tab bar and overflows the stack.)
                                 Declared last so the x:Reference is already resolved. -->
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Loaded">
                                    <ic:ChangePropertyAction TargetObject="{Binding}" PropertyName="ActiveFilterPreset"
                                                             IsEnabled="{Binding IsEnabled, Source={x:Reference StartTabPicker}}"
                                                             Value="{Binding Tag, Source={x:Reference StartTabPicker}}" />
                                </i:EventTrigger>
                                <ic:TimerTrigger EventName="Loaded" MillisecondsPerTick="500" TotalTicks="9">
                                    <ic:ChangePropertyAction TargetObject="{Binding}" PropertyName="ActiveFilterPreset"
                                                             IsEnabled="{Binding IsEnabled, Source={x:Reference StartTabPicker}}"
                                                             Value="{Binding Tag, Source={x:Reference StartTabPicker}}" />
                                </ic:TimerTrigger>
                                <ic:TimerTrigger EventName="Loaded" MillisecondsPerTick="5000" TotalTicks="1">
                                    <ic:ChangePropertyAction TargetObject="{Binding Source={x:Reference StartTabPicker}}"
                                                             PropertyName="IsEnabled" Value="False" />
                                </ic:TimerTrigger>
                            </i:Interaction.Triggers>
                        </Grid>

                        <GameDetails x:Name="PART_ElemGameDetails" Grid.RowSpan="3"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <GameStatus x:Name="PART_ElemGameStatus" Grid.RowSpan="3"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                    <!-- Layout per tab: Main.Tag = "Carousel" -> preview layout, anything else -> grid. Later triggers win. -->
                    <ControlTemplate.Triggers>
                        <!-- Built-in preview-layout tab names (Theme Options UseDefaultPreviewTabs = off drops them). -->
                        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="HOME">
                            <Setter Property="Tag" Value="Carousel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="FAVORITES">
                            <Setter Property="Tag" Value="Carousel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="FAVORITE">
                            <Setter Property="Tag" Value="Carousel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="FAVOURITES">
                            <Setter Property="Tag" Value="Carousel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="RECENT">
                            <Setter Property="Tag" Value="Carousel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="RECENTLY PLAYED">
                            <Setter Property="Tag" Value="Carousel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="RECENTLY ADDED">
                            <Setter Property="Tag" Value="Carousel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="RECENT GAMES">
                            <Setter Property="Tag" Value="Carousel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="MOST PLAYED">
                            <Setter Property="Tag" Value="Carousel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="TOP PLAYED">
                            <Setter Property="Tag" Value="Carousel" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Value="CONTINUE PLAYING">
                            <Setter Property="Tag" Value="Carousel" />
                        </DataTrigger>
                        <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[UseDefaultPreviewTabs]}" Value="False">
                            <Setter Property="Tag" Value="{x:Null}" />
                        </DataTrigger>
                        <!-- User-chosen names (Theme Options PreviewTab1-5, see PreviewSlot1-5). -->
                        <Trigger SourceName="PreviewSlot1" Property="Visibility" Value="Hidden">
                            <Setter Property="Tag" Value="Carousel" />
                        </Trigger>
                        <Trigger SourceName="PreviewSlot2" Property="Visibility" Value="Hidden">
                            <Setter Property="Tag" Value="Carousel" />
                        </Trigger>
                        <Trigger SourceName="PreviewSlot3" Property="Visibility" Value="Hidden">
                            <Setter Property="Tag" Value="Carousel" />
                        </Trigger>
                        <Trigger SourceName="PreviewSlot4" Property="Visibility" Value="Hidden">
                            <Setter Property="Tag" Value="Carousel" />
                        </Trigger>
                        <Trigger SourceName="PreviewSlot5" Property="Visibility" Value="Hidden">
                            <Setter Property="Tag" Value="Carousel" />
                        </Trigger>
                        <!-- No preset (custom filter from the Filters view): its name reads as "" and would match empty slots. -->
                        <DataTrigger Binding="{Binding ActiveFilterPreset}" Value="{x:Null}">
                            <Setter Property="Tag" Value="{x:Null}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
