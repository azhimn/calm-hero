<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
                    xmlns:ic="clr-namespace:Microsoft.Xaml.Behaviors.Core;assembly=Microsoft.Xaml.Behaviors"
                    xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
                    mc:Ignorable="d">

    <!-- ===================================================================================
         MAIN SCREEN

         Tabs (quick-filter presets) decide the layout:
           * HOME / FAVORITES / RECENT / MOST PLAYED ... -> single horizontal row, the selected
             cover is always centred (carousel).  Main.Tag == "Carousel"
           * ALL GAMES (and any other preset)            -> multi-row grid + A-Z position rail.
         Users can add names or drop the built-in list in Theme Options (see ControlTemplate.Triggers).
         Both layouts share the same data, selection, focus and controller bindings: the stock
         Playnite list (PART_ListGameItems) always owns input; in carousel mode it is kept
         invisible and a display-only list mirrors its selection.
         =================================================================================== -->

    <!-- A-Z rail letter. The active letter gets an accent disc. -->
    <Style x:Key="RailLetter" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>

    <!-- Small info pill in the carousel hero line (playtime, last played, favorite, installed) -->
    <Style x:Key="HeroPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="#B80A1217" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0,18,0" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="HeroPillIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontIcons}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,9,0" />
    </Style>

    <!-- Invisible hit area (touch). Transparent but hit-testable; never takes focus. -->
    <Style x:Key="CarouselTapZone" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="#01000000" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Carousel item: one 310 px slot per game (270 x 360 cover). The strip is shifted by SelectedIndex x 310
         (see CarouselList), so the selected cover is always exactly in the middle. -->
    <Style x:Key="CarouselItemStyle" TargetType="ListBoxItem">
        <Setter Property="Width" Value="310" />
        <Setter Property="Height" Value="500" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="CarouselOn">
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                                             To="1.08" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                                             To="1.08" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.18" />
                        </Storyboard>
                        <Storyboard x:Key="CarouselOff">
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX"
                                             To="0.92" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY"
                                             To="0.92" Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="Tile" Storyboard.TargetProperty="Opacity"
                                             To="0.8" Duration="0:0:0.18" />
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid Background="{x:Null}">
                      <!-- The virtualizing panel only numbers the slots it has created: AlternationIndex is consecutive
                           there but not the real item index after a jump. So the selected slot publishes its own
                           AlternationIndex on the list's Tag, and depth is measured from that. -->
                      <i:Interaction.Triggers>
                          <ic:DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                              <ic:ChangePropertyAction TargetObject="{Binding RelativeSource={RelativeSource AncestorType=ListBox}}" PropertyName="Tag"
                                                       Value="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                          </ic:DataTrigger>
                      </i:Interaction.Triggers>
                      <!-- distance from the selected cover: each step to the side is a little smaller and dimmer -->
                      <Grid x:Name="DepthHost" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform>
                                <ScaleTransform.ScaleX>
                                    <MultiBinding Converter="{StaticResource MathConverter}"
                                                  ConverterParameter="[2] &lt; 0 ? 1 : 1 - 0.05 * Min(Abs([0] - [1]), 4)">
                                        <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                        <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        <Binding Path="SelectedIndex" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    </MultiBinding>
                                </ScaleTransform.ScaleX>
                                <ScaleTransform.ScaleY>
                                    <MultiBinding Converter="{StaticResource MathConverter}"
                                                  ConverterParameter="[2] &lt; 0 ? 1 : 1 - 0.05 * Min(Abs([0] - [1]), 4)">
                                        <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                        <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                        <Binding Path="SelectedIndex" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    </MultiBinding>
                                </ScaleTransform.ScaleY>
                            </ScaleTransform>
                        </Grid.RenderTransform>
                        <Grid.Opacity>
                            <MultiBinding Converter="{StaticResource MathConverter}"
                                          ConverterParameter="[2] &lt; 0 ? 1 : 1 - 0.12 * Min(Abs([0] - [1]), 4)">
                                <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=ListBoxItem}" />
                                <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                <Binding Path="SelectedIndex" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                            </MultiBinding>
                        </Grid.Opacity>
                        <Grid x:Name="Tile" Width="270" Height="360"
                              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                              RenderTransformOrigin="0.5,0.5" Opacity="0.8">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="TileScale" ScaleX="0.92" ScaleY="0.92" />
                            </Grid.RenderTransform>
                            <ContentPresenter />
                            <!-- optional ring (Ring / Thin accent presets); invisible with the default Lift style -->
                            <Border x:Name="Ring" Margin="-7" CornerRadius="16" IsHitTestVisible="False" Visibility="Hidden"
                                    BorderThickness="{DynamicResource SelectionRingThickness}"
                                    BorderBrush="{DynamicResource SelectionRingBrush}" />
                        </Grid>
                      </Grid>

                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Canvas.ZIndex" Value="90" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="CarouselOnAnim" Storyboard="{StaticResource CarouselOn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="CarouselOnAnim" />
                                <BeginStoryboard Storyboard="{StaticResource CarouselOff}" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The real Playnite game list. In carousel mode it is made invisible and shrunk to a single-row
         stand-in (still focusable, still handles A/X/Start/Enter and navigation). -->
    <Style x:Key="MainGameListStyle" TargetType="{x:Type ListBoxEx}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Main}}}" Value="Carousel">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Width" Value="500" />
                <!-- one row tall: 1.4 x cover height of a 500 px wide, (Columns + 0.5)-column strip -->
                <Setter Property="Height">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource MathConverter}"
                                      ConverterParameter="700 * [2] / ([1] * ([0] + 0.5))">
                            <Binding Path="AppSettings.Fullscreen.Columns" />
                            <Binding Path="AppSettings.GridItemWidthRatio" />
                            <Binding Path="AppSettings.GridItemHeightRatio" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Stock tile panel: carousel mode flips it to a single horizontal row. Animations outrank the
         bindings Playnite sets in code, so this works without touching the global layout settings. -->
    <Style TargetType="{x:Type FullscreenTilePanel}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Main}}}" Value="Carousel">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="CarouselRowOn">
                        <Storyboard>
                            <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="(FullscreenTilePanel.UseHorizontalLayout)">
                                <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True" />
                            </BooleanAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="CarouselRowOn" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid x:Name="PART_ViewHost" Background="{DynamicResource MainBackgourndBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Start tab. Playnite reopens the last used tab; by default the theme starts on the first tab
                                 instead (tab order comes from Playnite's filter presets). Theme Options "Reopen the last used
                                 tab" (RememberLastTab) skips this. -->

                            <!-- StartTabPicker: Tag = the first tab. IsEnabled = "start-tab logic armed": off from the start when
                                 Theme Options RememberLastTab is on, switched off once the start tab has been applied. -->
                            <Border x:Name="StartTabPicker" Visibility="Collapsed" Tag="{Binding SortedFilterFullscreenPresets[0]}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=ThemeOptions, Path=Options[RememberLastTab]}" Value="True">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Per-tab layout slots. PreviewSlotN is Hidden (not Collapsed) while the active tab's name equals Theme Options
                                 PreviewTabN (case-insensitive); signalled via Visibility because a template trigger may not read and set Tag. ControlTemplate.Triggers turn that into the preview layout.
                                 Tag = the slot's name; behaviours DataTrigger because its Value can be a binding (a WPF DataTrigger's can't). -->
                            <Border x:Name="PreviewSlot1" Visibility="Collapsed"
                                    Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[PreviewTab1], Converter={StaticResource StringToUpperCaseConverter}}">
                                <i:Interaction.Triggers>
                                    <ic:DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Comparison="Equal"
                                                    Value="{Binding Tag, ElementName=PreviewSlot1}">
                                        <ic:ChangePropertyAction PropertyName="Visibility" Value="Hidden" />
                                    </ic:DataTrigger>
                                    <ic:DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Comparison="NotEqual"
                                                    Value="{Binding Tag, ElementName=PreviewSlot1}">
                                        <ic:ChangePropertyAction PropertyName="Visibility" Value="Collapsed" />
                                    </ic:DataTrigger>
                                </i:Interaction.Triggers>
                            </Border>
                            <Border x:Name="PreviewSlot2" Visibility="Collapsed"
                                    Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[PreviewTab2], Converter={StaticResource StringToUpperCaseConverter}}">
                                <i:Interaction.Triggers>
                                    <ic:DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Comparison="Equal"
                                                    Value="{Binding Tag, ElementName=PreviewSlot2}">
                                        <ic:ChangePropertyAction PropertyName="Visibility" Value="Hidden" />
                                    </ic:DataTrigger>
                                    <ic:DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Comparison="NotEqual"
                                                    Value="{Binding Tag, ElementName=PreviewSlot2}">
                                        <ic:ChangePropertyAction PropertyName="Visibility" Value="Collapsed" />
                                    </ic:DataTrigger>
                                </i:Interaction.Triggers>
                            </Border>
                            <Border x:Name="PreviewSlot3" Visibility="Collapsed"
                                    Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[PreviewTab3], Converter={StaticResource StringToUpperCaseConverter}}">
                                <i:Interaction.Triggers>
                                    <ic:DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Comparison="Equal"
                                                    Value="{Binding Tag, ElementName=PreviewSlot3}">
                                        <ic:ChangePropertyAction PropertyName="Visibility" Value="Hidden" />
                                    </ic:DataTrigger>
                                    <ic:DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Comparison="NotEqual"
                                                    Value="{Binding Tag, ElementName=PreviewSlot3}">
                                        <ic:ChangePropertyAction PropertyName="Visibility" Value="Collapsed" />
                                    </ic:DataTrigger>
                                </i:Interaction.Triggers>
                            </Border>
                            <Border x:Name="PreviewSlot4" Visibility="Collapsed"
                                    Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[PreviewTab4], Converter={StaticResource StringToUpperCaseConverter}}">
                                <i:Interaction.Triggers>
                                    <ic:DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Comparison="Equal"
                                                    Value="{Binding Tag, ElementName=PreviewSlot4}">
                                        <ic:ChangePropertyAction PropertyName="Visibility" Value="Hidden" />
                                    </ic:DataTrigger>
                                    <ic:DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Comparison="NotEqual"
                                                    Value="{Binding Tag, ElementName=PreviewSlot4}">
                                        <ic:ChangePropertyAction PropertyName="Visibility" Value="Collapsed" />
                                    </ic:DataTrigger>
                                </i:Interaction.Triggers>
                            </Border>
                            <Border x:Name="PreviewSlot5" Visibility="Collapsed"
                                    Tag="{PluginSettings Plugin=ThemeOptions, Path=Options[PreviewTab5], Converter={StaticResource StringToUpperCaseConverter}}">
                                <i:Interaction.Triggers>
                                    <ic:DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Comparison="Equal"
                                                    Value="{Binding Tag, ElementName=PreviewSlot5}">
                                        <ic:ChangePropertyAction PropertyName="Visibility" Value="Hidden" />
                                    </ic:DataTrigger>
                                    <ic:DataTrigger Binding="{Binding ActiveFilterPreset.Name, Converter={StaticResource StringToUpperCaseConverter}}" Comparison="NotEqual"
                                                    Value="{Binding Tag, ElementName=PreviewSlot5}">
                                        <ic:ChangePropertyAction PropertyName="Visibility" Value="Collapsed" />
                                    </ic:DataTrigger>
                                </i:Interaction.Triggers>
                            </Border>

                            <!-- Playnite binds this required part to the selected game's background art. -->
                            <!-- Same setup as Playnite's own theme (no Effect, no Stretch override): FadeImage caches
                                 itself in a bitmap and flickers if a shader effect is layered on top of it. -->
                            <FadeImage x:Name="PART_ImageBackground" Grid.RowSpan="3" RenderOptions.BitmapScalingMode="LowQuality"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" />

                            <Border Grid.RowSpan="3" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#40081013" Offset="0" />
                                        <GradientStop Color="#00081013" Offset="0.22" />
                                        <GradientStop Color="#00081013" Offset="0.50" />
                                        <GradientStop Color="#99081013" Offset="0.80" />
                                        <GradientStop Color="#E0081013" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- carousel tabs: keep the hero text readable on bright art with a full-width left-to-right shade
                                 (full screen, so it never shows an edge) -->
                            <Border Grid.RowSpan="3" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#99081013" Offset="0" />
                                        <GradientStop Color="#80081013" Offset="0.25" />
                                        <GradientStop Color="#40081013" Offset="0.45" />
                                        <GradientStop Color="#00081013" Offset="0.7" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="Carousel">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- ============ TOP BAR: status | tabs | settings ============ -->
                            <!-- Clock and battery sit on the left; Playnite shows/hides them from its own
                                 Fullscreen settings (Show clock / Show battery / Show battery percentage). -->
                            <Grid Grid.Row="0" Background="{DynamicResource TopBarBackgroundBrush}"
                                  Height="104">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Left" Margin="44,0,0,0">
                                    <TextBlock x:Name="PART_TextClock" Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,26,0" />

                                    <!-- Playnite only exposes "charging". Plugged in at a charge limit, Windows reports
                                         "not charging", so also read the AC line (re-read every 10 s; Windows Forms PowerStatus
                                         is a fresh query on each property read but has no change notification). -->
                                    <TextBlock x:Name="AcLineProbe" Visibility="Collapsed" Text="{Binding PowerLineStatus}"
                                               DataContext="{x:Static wf:SystemInformation.PowerStatus}">
                                        <i:Interaction.Triggers>
                                            <ic:TimerTrigger EventName="Loaded" MillisecondsPerTick="10000">
                                                <ic:ChangePropertyAction PropertyName="DataContext" Value="{x:Null}" />
                                                <ic:ChangePropertyAction PropertyName="DataContext" Value="{x:Static wf:SystemInformation.PowerStatus}" />
                                            </ic:TimerTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBlock>

                                    <ContentControl x:Name="PART_ElemBatteryStatus" Focusable="False" FontSize="28"
                                                    VerticalAlignment="Center" Margin="0,2,8,0">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Critical">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusCritical}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Low">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusLow}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Medium">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusMedium}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="High">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusHigh}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PowerStatus.IsCharging}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusCharging}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </DataTrigger>
                                                    <!-- On AC (charging, or held at a charge limit): charging glyph for the current level -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, ElementName=AcLineProbe}" Value="Online" />
                                                            <Condition Binding="{Binding PowerStatus.Charge}" Value="Critical" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusChargingCritical}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, ElementName=AcLineProbe}" Value="Online" />
                                                            <Condition Binding="{Binding PowerStatus.Charge}" Value="Low" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusChargingLow}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, ElementName=AcLineProbe}" Value="Online" />
                                                            <Condition Binding="{Binding PowerStatus.Charge}" Value="Medium" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusChargingMedium}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, ElementName=AcLineProbe}" Value="Online" />
                                                            <Condition Binding="{Binding PowerStatus.Charge}" Value="High" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Content" Value="{DynamicResource BatteryStatusChargingHigh}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>

                                    <TextBlock x:Name="PART_TextBatteryPercentage" Style="{DynamicResource TextBlockBaseStyle}"
                                               FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />

                                    <ButtonEx x:Name="PART_ButtonProgramUpdate" VerticalAlignment="Center"
                                              Margin="22,0,0,0" Height="48" MinWidth="48"
                                              Style="{DynamicResource ButtonTopMenu}">
                                        <ButtonEx.Content>
                                            <TextBlock Text="&#xE896;" FontFamily="{DynamicResource FontIcons}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentSoftBrush}" FontSize="24" />
                                        </ButtonEx.Content>
                                    </ButtonEx>

                                    <ButtonEx x:Name="PART_ButtonNotifications" VerticalAlignment="Center"
                                              Margin="10,0,0,0" Height="48" MinWidth="48">
                                        <Button.Content>
                                            <Grid>
                                                <TextBlock Text="&#xEA8F;" FontFamily="{DynamicResource FontIcons}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}" FontSize="24" />
                                                <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" />
                                            </Grid>
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonTopMenu}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </ButtonEx>
                                </StackPanel>

                                <!-- LB  tabs  RB -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptLB}" Height="30"
                                                    Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center"
                                                    Margin="0,0,10,0" Opacity="0.85" />
                                    <FilterPresetSelector x:Name="PART_FilterPresetSelector" VerticalAlignment="Center" />
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptRB}" Height="30"
                                                    Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center"
                                                    Margin="10,0,0,0" Opacity="0.85" />
                                </StackPanel>

                                <!-- settings: View button opens the main menu -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,0,40,0">
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptBack}" Height="28"
                                                    Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center"
                                                    Margin="0,0,12,0" Opacity="0.85" />
                                    <ButtonEx x:Name="PART_ButtonMainMenu" VerticalAlignment="Center"
                                              Style="{DynamicResource ButtonTopMenu}"
