<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
                    xmlns:ic="clr-namespace:Microsoft.Xaml.Behaviors.Core;assembly=Microsoft.Xaml.Behaviors"
                    mc:Ignorable="d">

    <!-- Card heading on the details screen: sentence case, muted, no accent colour -->
    <Style x:Key="DetailsHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontUI}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="DetailsLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    </Style>

    <Style x:Key="DetailsValue" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize" Value="27" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Row in the Details card -->
    <Style x:Key="DetailsKey" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="DetailsData" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- Card surface used by every block in the right column -->
    <Style x:Key="DetailsCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceTranslucentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="26,20,26,22" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!--
        Action buttons on the details screen. Secondary look by default (raised fill, readable white text);
        set Tag="Primary" for the filled accent Play button. Focus = lift: the button grows slightly and gets
        a light fill; the ring only shows when a Theme Options selection preset gives it a thickness.
    -->
    <Style x:Key="DetailsActionButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource FontUI}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Height" Value="62" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="FocusOn">
                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.16" />
                        </Storyboard>
                        <Storyboard x:Key="FocusOff">
                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16" />
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Lift" />
                        </Grid.RenderTransform>
                        <Border x:Name="Face" CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="FocusFill" CornerRadius="14" Background="{DynamicResource FocusFillBrush}" Visibility="Hidden" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                        <Border x:Name="FocusRing" CornerRadius="20" Margin="-6" Visibility="Hidden" IsHitTestVisible="False"
                                BorderThickness="{DynamicResource SelectionRingThickness}"
                                BorderBrush="{DynamicResource SelectionRingBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Primary">
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusFill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FocusOnAnim" Storyboard="{StaticResource FocusOn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FocusOnAnim" />
                                <BeginStoryboard Storyboard="{StaticResource FocusOff}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusFill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type GameDetails}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameDetails}">
                    <Grid x:Name="PART_ViewHost"
                          Background="{DynamicResource MainBackgourndBrush}"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="86" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="76" />
                        </Grid.RowDefinitions>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="IsVisibleChanged">
                                <i:InvokeCommandAction Command="{Binding Content.VideoPauseCommand, ElementName=ExtraMetadataLoader_VideoLoaderControl}" />
                                <ic:ChangePropertyAction TargetObject="{Binding ElementName=TrailerState}"
                                                         PropertyName="IsChecked" Value="False" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <FadeImage Grid.RowSpan="3"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   x:Name="PART_ImageBackground" />

                        <Border Grid.RowSpan="3" Background="#8C081013" />
                        <Border Grid.RowSpan="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#D9060B10" Offset="0" />
                                    <GradientStop Color="#66060B10" Offset="0.45" />
                                    <GradientStop Color="#10060B10" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Grid.RowSpan="3" Background="{DynamicResource GameDetailsBackgroundBrush}" />

                        <!-- ================= TOP: library icon only (B = back is in the bottom bar) ================= -->
                        <Image Grid.Row="0" Source="{Binding LibraryPlugin.LibraryIcon}"
                               Height="36" Width="36" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,10,72,0" Opacity="0.9" RenderOptions.BitmapScalingMode="Fant" />

                        <!-- ================= CONTENT ================= -->
                        <Grid x:Name="DetailsContent" Grid.Row="1" Margin="88,0,72,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="560" />
                            </Grid.ColumnDefinitions>

                            <!-- left column: cover + actions -->
                            <StackPanel Grid.Column="0">
                                <Border Width="340" Height="510" CornerRadius="16" HorizontalAlignment="Left"
                                        Background="#B20A1014">
                                    <Image x:Name="PART_ImageCover" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="Fant">
                                        <Image.Clip>
                                            <RectangleGeometry RadiusX="16" RadiusY="16">
                                                <RectangleGeometry.Rect>
                                                    <MultiBinding Converter="{StaticResource MathConverter}" ConverterParameter="0, 0, [0], [1]">
                                                        <Binding Path="ActualWidth" ElementName="PART_ImageCover" />
                                                        <Binding Path="ActualHeight" ElementName="PART_ImageCover" />
                                                    </MultiBinding>
                                                </RectangleGeometry.Rect>
                                            </RectangleGeometry>
                                        </Image.Clip>
                                    </Image>
                                </Border>

                                <!-- Play / Install (Playnite sets the label) -->
                                <ButtonEx x:Name="PART_ButtonContext" Tag="Primary"
                                          Style="{StaticResource DetailsActionButton}"
                                          Margin="0,22,0,0" Width="340" HorizontalAlignment="Left"
                                          FontSize="26" Height="66" />

                                <ButtonEx x:Name="PART_ButtonOptions"
                                          Style="{StaticResource DetailsActionButton}"
                                          Margin="0,12,0,0" Width="340" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE712;" FontFamily="{DynamicResource FontIcons}" FontSize="20"
                                                   VerticalAlignment="Center" Margin="0,2,12,0" />
                                        <TextBlock Text="{DynamicResource LOCGameOptions}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ButtonEx>

                                <!-- Trailer: opens the in-theme player below. Hidden when the game has no trailer. -->
                                <ButtonEx x:Name="TrailerButton"
                                          Command="{Binding Content.VideoPlayCommand, ElementName=ExtraMetadataLoader_VideoLoaderControl}"
                                          Margin="0,12,0,0" Width="340" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="{DynamicResource FontIcons}" FontSize="20"
                                                   VerticalAlignment="Center" Margin="0,2,12,0" />
                                        <TextBlock Text="Trailer" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <i:Interaction.Triggers>
                                        <!-- Click runs before the command, so the player is already on screen when playback starts -->
                                        <i:EventTrigger EventName="Click">
                                            <ic:ChangePropertyAction TargetObject="{Binding ElementName=TrailerState}"
                                                                     PropertyName="IsChecked" Value="True" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <ButtonEx.Style>
                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource DetailsActionButton}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding Content, ElementName=ExtraMetadataLoader_VideoLoaderControl}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ButtonEx.Style>
                                </ButtonEx>

                                <!-- favorite state (read-only; toggled from Game options) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="&#xE735;" FontFamily="{DynamicResource FontIcons}" FontSize="19"
                                               Foreground="#FFFFD65A" VerticalAlignment="Center" Margin="0,2,10,0" />
                                    <TextBlock Text="Favorite" Style="{DynamicResource TextBlockBaseStyle}" FontSize="22"
                                               FontWeight="SemiBold" Foreground="#FFFFD65A" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- middle column: title, meta, about -->
                            <Grid Grid.Column="1" Margin="56,0,56,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Extra Metadata Loader logo is not repeated here: the title is the heading -->
                                <ContentControl x:Name="ExtraMetadataLoader_LogoLoaderControl" Visibility="Collapsed" />

                                <TextBlock Grid.Row="0" Text="{Binding DisplayName}"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           FontFamily="{DynamicResource FontUI}" FontWeight="SemiBold"
                                           FontSize="60" LineHeight="66" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           MaxHeight="140" Foreground="{DynamicResource TextBrush}" Margin="0,-6,0,0" />

                                <TextBlock Grid.Row="1" Margin="0,12,0,0"
                                           Style="{DynamicResource TextBlockBaseStyle}"
                                           FontSize="23" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" MaxHeight="70">
                                    <Run Text="{Binding Genres, Converter={StaticResource ListToStringConverter}, ConverterParameter=', ', Mode=OneWay}" />
                                    <Run Text="  &#x2022;  " Foreground="{DynamicResource TextFaintBrush}" />
                                    <Run Text="{Binding Developers, Converter={StaticResource ListToStringConverter}, ConverterParameter=', ', Mode=OneWay}" />
                                    <Run Text="  &#x2022;  " Foreground="{DynamicResource TextFaintBrush}" />
                                    <Run Text="{Binding ReleaseYear, Mode=OneWay}" />
                                    <Run Text="  &#x2022;  " Foreground="{DynamicResource TextFaintBrush}" />
                                    <Run Text="{Binding AgeRatings, Converter={StaticResource ListToStringConverter}, ConverterParameter=', ', Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Grid.Row="2" Text="About" Style="{StaticResource DetailsHeading}"
                                           Margin="0,40,0,10" />

                                <ScrollViewerEx Grid.Row="3" Margin="0,0,0,0" x:Name="PART_ScrollHtmlDescription" MaxWidth="900"
                                                HorizontalAlignment="Left">
                                    <HtmlTextView x:Name="PART_HtmlDescription"
                                                  HtmlFontSize="22"
                                                  HtmlFontFamily="{DynamicResource FontUI}"
                                                  HtmlForeground="{DynamicResource TextColor}"
                                                  LinkForeground="{DynamicResource AccentSoftColor}"
                                                  FocusVisualStyle="{x:Null}" />
                                </ScrollViewerEx>
                            </Grid>

                            <!-- right column: activity, ratings, details, achievements -->
                            <StackPanel Grid.Column="2">

                                <!-- Your activity -->
                                <Border Style="{StaticResource DetailsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Your activity" Style="{StaticResource DetailsHeading}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,16">
                                                <TextBlock Text="Play time" Style="{StaticResource DetailsLabel}" />
                                                <TextBlock Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}"
                                                           Style="{StaticResource DetailsValue}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                                                <TextBlock Text="Last played" Style="{StaticResource DetailsLabel}" />
                                                <TextBlock Text="{Binding LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}"
                                                           Style="{StaticResource DetailsValue}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Sessions" Style="{StaticResource DetailsLabel}" />
                                                <TextBlock Text="{Binding PlayCount}" Style="{StaticResource DetailsValue}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBlock Text="Status" Style="{StaticResource DetailsLabel}" />
                                                <TextBlock Text="{Binding CompletionStatus.Name, TargetNullValue=&#x2014;}" Style="{StaticResource DetailsValue}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Ratings -->
                                <Border Style="{StaticResource DetailsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Ratings" Style="{StaticResource DetailsHeading}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Community" Style="{StaticResource DetailsLabel}" />
                                                <TextBlock Text="{Binding CommunityScore, TargetNullValue=&#x2014;}" Style="{StaticResource DetailsValue}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Critic" Style="{StaticResource DetailsLabel}" />
                                                <TextBlock Text="{Binding CriticScore, TargetNullValue=&#x2014;}" Style="{StaticResource DetailsValue}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="You" Style="{StaticResource DetailsLabel}" />
                                                <TextBlock Text="{Binding UserScore, TargetNullValue=&#x2014;}" Style="{StaticResource DetailsValue}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Details -->
                                <Border Style="{StaticResource DetailsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Details" Style="{StaticResource DetailsHeading}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Developer" Style="{StaticResource DetailsKey}" Margin="0,4" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailsData}" Margin="0,4"
                                                       Text="{Binding Developers, Converter={StaticResource ListToStringConverter}, ConverterParameter=', '}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Publisher" Style="{StaticResource DetailsKey}" Margin="0,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailsData}" Margin="0,4"
                                                       Text="{Binding Publishers, Converter={StaticResource ListToStringConverter}, ConverterParameter=', '}" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Released" Style="{StaticResource DetailsKey}" Margin="0,4" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailsData}" Margin="0,4"
                                                       Text="{Binding ReleaseDate}" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Platform" Style="{StaticResource DetailsKey}" Margin="0,4" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailsData}" Margin="0,4"
                                                       Text="{Binding Platforms, Converter={StaticResource ListToStringConverter}, ConverterParameter=', '}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Achievements (SuccessStory). Hidden when the plugin supplies nothing. -->
                                <Border Style="{StaticResource DetailsCard}"
                                        Visibility="{Binding Content, ElementName=SuccessStory_PluginProgressBar, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Achievements" Style="{StaticResource DetailsHeading}" />
                                        <ContentControl x:Name="SuccessStory_PluginProgressBar" Focusable="False" />
                                        <ContentControl x:Name="SuccessStory_PluginCompactUnlocked" Focusable="False" Margin="0,10,0,0" MaxHeight="80" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ================= BOTTOM HINTS ================= -->
                        <Border Grid.Row="2" Background="{DynamicResource BottomBarBackgroundBrush}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="56,0,0,0">
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptA}" Height="30" Focusable="False"
                                                    IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,11,0" />
                                    <TextBlock Text="Select" Style="{DynamicResource TextBlockBaseStyle}"
                                               FontWeight="SemiBold" FontSize="23" VerticalAlignment="Center" />
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Height="30" Focusable="False"
                                                    IsHitTestVisible="False" VerticalAlignment="Center" Margin="34,0,11,0" />
                                    <TextBlock Text="Back" Style="{DynamicResource TextBlockBaseStyle}"
                                               FontWeight="SemiBold" FontSize="23" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,56,0">
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptLB}" Height="30" Focusable="False"
                                                    IsHitTestVisible="False" VerticalAlignment="Center" />
                                    <Border Width="8" />
                                    <ContentControl ContentTemplate="{DynamicResource ButtonPromptRB}" Height="30" Focusable="False"
                                                    IsHitTestVisible="False" VerticalAlignment="Center" />
                                    <TextBlock Text="Previous / next game" Style="{DynamicResource TextBlockBaseStyle}"
                                               FontWeight="SemiBold" FontSize="23"
                                               Margin="11,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ===== trailer player (theme-owned; the plugin's own fullscreen window has no gamepad exit) ===== -->
                        <CheckBox x:Name="TrailerState" Visibility="Collapsed" Focusable="False" IsTabStop="False" IsChecked="False" />

                        <Grid x:Name="TrailerOverlay" Grid.RowSpan="3">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=TrailerState}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                            <Setter Property="IsHitTestVisible" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" Background="#F5000000" />

                            <!-- Extra Metadata Loader's player. Lives here (not collapsed) so it is always loaded and ready. -->
                            <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControl" Grid.Row="0"
                                            Margin="90,50,90,20" Focusable="False" IsTabStop="False" />

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,34">
                                <ButtonEx x:Name="TrailerCloseButton" Content="Close trailer"
                                          Style="{StaticResource DetailsActionButton}"
                                          Width="340"
                                          IsEnabled="{Binding IsChecked, ElementName=TrailerState}"
                                          FocusBahaviors.FocusBinding="{Binding IsChecked, ElementName=TrailerState}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <i:InvokeCommandAction Command="{Binding Content.VideoPauseCommand, ElementName=ExtraMetadataLoader_VideoLoaderControl}" />
                                            <ic:ChangePropertyAction TargetObject="{Binding ElementName=TrailerState}"
                                                                     PropertyName="IsChecked" Value="False" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ButtonEx>
                                <ContentControl ContentTemplate="{DynamicResource ButtonPromptB}" Height="30" Margin="26,0,10,0"
                                                Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" />
                                <TextBlock Text="Back to details" Style="{DynamicResource TextBlockBaseStyle}"
                                           FontWeight="SemiBold" FontSize="23"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- details content fades in every time the screen is shown -->
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DetailsContent" Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.26" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
