<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pmrk="clr-namespace:Playnite.FullscreenApp.Markup;assembly=Playnite.FullscreenApp">
    
    <Style x:Key="MainMenuBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OverlayMenuBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Margin" Value="0,20,-80,20" />
        <Setter Property="Padding" Value="18,10,18,18" />
        <Setter Property="MinWidth" Value="500" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                        <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,-128,20" To="0,20,-80,20" Duration="0:0:0.3">
                            <ThicknessAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="6" /></ThicknessAnimation.EasingFunction>
                        </ThicknessAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MainMenuButton" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Padding" Value="18,0,18,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <DataTemplate x:Key="MainMenuHeaderTemplate">
        <TextBlock Text="Menu" FontSize="34" FontWeight="SemiBold" Style="{DynamicResource TextBlockBaseStyle}"
                   Margin="18,26,40,18" />
    </DataTemplate>

    <DataTemplate x:Key="MainMenuSettingsButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE713;" FontFamily="{DynamicResource FontIcons}" FontSize="21"
                       VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,1,16,0"/>
            <TextBlock Text="{DynamicResource LOCSettingsLabel}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

