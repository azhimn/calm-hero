<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Check boxes are drawn as rows: label on the left, a toggle switch on the right.
        Used by the filter panel, settings, item lists and the keyboard options.
        Focus = lighter row fill (plus the selection ring when a Theme Options preset enables it).
    -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="18,0,16,0" />
        <Setter Property="MinHeight" Value="62" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="On">
                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="26" Duration="0:0:0.16" />
                        </Storyboard>
                        <Storyboard x:Key="Off">
                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16" />
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid>
                        <Border x:Name="FocusFill" CornerRadius="14" Background="{TemplateBinding Background}" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Grid.Column="0" TextTrimming="CharacterEllipsis" Margin="0,0,18,0">
                                <ContentPresenter RecognizesAccessKey="True" />
                            </TextBlock>
                            <!-- switch -->
                            <Grid Grid.Column="1" Width="58" Height="32" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="16" Background="#29FFFFFF" />
                                <Ellipse x:Name="Knob" Width="24" Height="24" Fill="#FFC8D1D5"
                                         HorizontalAlignment="Left" Margin="4,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobShift" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <Border x:Name="FocusRing" Margin="-5" CornerRadius="19" Visibility="Hidden" IsHitTestVisible="False"
                                BorderThickness="{DynamicResource SelectionRingThickness}"
                                BorderBrush="{DynamicResource SelectionRingBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="OnAnim" Storyboard="{StaticResource On}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="OnAnim" />
                                <BeginStoryboard Storyboard="{StaticResource Off}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusFill" Property="Background" Value="{DynamicResource FocusFillBrush}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusFill" Property="Background" Value="{DynamicResource FocusFillBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBoxEx" BasedOn="{StaticResource {x:Type CheckBox}}">
    </Style>
</ResourceDictionary>
